{
  "name": "dsh-yu-mood",
  "version": "0.4.2",
  "description": "给 AI 伙伴一个会自己判断、你看得见的心情：每轮聊完自动判断涨跌，右下角挂饰点开看数值 + 情绪 + 时间线；心情怎么告诉它（不告诉 / 只说心情 / 说它刚才那件事）和可信度门槛都能在设置里改。",
  "license": "MIT",
  "author": "Speraymer",
  "contributors": [
    "Yuuyuko-uu (https://github.com/Yuuyuko-uu)"
  ],
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "mood",
    "ai-companion"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Speraymer/dsh-yu-mood.git"
  },
  "homepage": "https://github.com/Speraymer/dsh-yu-mood#readme",
  "bugs": {
    "url": "https://github.com/Speraymer/dsh-yu-mood/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    },
    "基于": "git+https://github.com/Yuuyuko-uu/dsh-feiyu-mood.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
